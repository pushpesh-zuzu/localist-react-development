#############################################
# React App URLs
#############################################
VITE_REACT_HOME_URL="https://dev.localists.com/"
VITE_REACT_APP_BASE_URL="https://dev.localists.com/admin/"
VITE_REACT_APP_API_BASE_URL="https://dev.localists.com/admin/api/"

#############################################
# Vite Development Server (npm run dev)
#############################################

# Host for Vite dev server (use 0.0.0.0 to allow LAN access)
HOST=0.0.0.0
PORT=5173

# Optional: custom port for Hot Module Reload (defaults: 24680)
# HMR_PORT=24680


#############################################
# Vite Preview Server (npm run preview)
#############################################

# Host for vite preview (used when testing the production build locally)
PREVIEW_HOST=0.0.0.0
PREVIEW_PORT=4173


#############################################
# Express SSR Server (node server.js)
#############################################

# Host for SSR server (used in production/staging)
SSR_HOST=127.0.0.1
SSR_PORT=3000
